  "_comment_pronouns": "Personal pronouns become the role noun ('the operator'). Possessive pronouns become 'the', because 'the operator hand' is not English but 'the hand was withdrawn' is. 'her' is both, so the code decides by whether a word follows it.",

  "pronounRewrites": {
    "he": "the {role}",
    "she": "the {role}",
    "him": "the {role}",
    "himself": "the {role}",
    "herself": "the {role}",
    "themselves": "the {role}",
    "i": "the {role}",
    "me": "the {role}",
