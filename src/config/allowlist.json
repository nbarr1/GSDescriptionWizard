  "identifierPatterns": [
    {
      "id": "email",
      "label": "an email address",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "flags": "g"
    },
    {
      "id": "phone",
      "label": "a phone number",
      "pattern": "(?:\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]\\d{3}[-.\\s]\\d{4}\\b",
      "flags": "g"
    },
    {
      "id": "ssn",
      "label": "a social security number",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "flags": "g"
    },
    {
      "id": "labelled_id",
      "label": "a labelled employee identifier",
      "pattern": "\\b(?:sso|badge|emp(?:loyee)?|payroll|clock|personnel)\\s*(?:id|no|num|number|#)?\\s*[:#-]?\\s*\\d{3,}",
      "flags": "gi"
    },
    {
      "id": "dob",
      "label": "a date of birth",
      "pattern": "\\b(?:dob|date of birth|born)\\b\\s*[:\\-]?\\s*\\d{1,2}[/\\-.]\\d{1,2}[/\\-.]\\d{2,4}",
      "flags": "gi"
    },
    {
      "id": "bare_dob",
      "label": "a full date that may be a date of birth",
      "pattern": "\\b(?:0?[1-9]|1[0-2])[/\\-](?:0?[1-9]|[12]\\d|3[01])[/\\-](?:19|20)\\d{2}\\b",
      "flags": "g"
    },
    {
      "id": "honorific",
      "label": "a personal title followed by a name",
      "pattern": "\\b(?:mr|mrs|ms|miss|dr)\\.?\\s+[A-Z][a-z]+",
      "flags": "g"
    }
  ]
